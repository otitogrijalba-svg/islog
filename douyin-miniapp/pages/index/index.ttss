  top: 54.4vh;
}

.profile-favorites-hit {
  top: 61.7vh;
}

.profile-trash-hit {
  top: 67.4vh;
}

.profile-help-hit {
  top: 74.7vh;
}

.toast {
  position: absolute;
  left: 50vw;
  bottom: 11.5vh;
  z-index: 40;
  max-width: 76vw;
  padding: 10px 18px;
  border-radius: 999px;
  background: rgba(43, 48, 52, 0.78);
  color: #fff;
  font-size: 15px;
  line-height: 1.35;
  text-align: center;
  transform: translateX(-50%);
  animation: toastIn 1800ms ease both;
  white-space: nowrap;
}

.picker {
  position: absolute;
  inset: 0;
  z-index: 20;
  width: 100vw;
  height: 100vh;
}

.picker-image {
  z-index: 21;
}

.emotion-hit,
.close-hit {
  z-index: 22;
}

.emotion-hit {
  width: 22vw;
  height: 14.4vh;
  border-radius: 999px;
}

.pick-happy {
  left: 9.5vw;
  top: 59.2vh;
}

.pick-anxious {
  left: 39vw;
  top: 59.2vh;
}

.pick-calm {
  left: 68.5vw;
  top: 59.2vh;
}

.pick-angry {
  left: 24vw;
  top: 74.2vh;
}

.pick-sad {
  left: 54vw;
  top: 74.2vh;
}

.close-hit {
  left: 42.8vw;
  top: 88.2vh;
  width: 14.8vw;
  height: 8.2vh;
  border-radius: 999px;
}

.fx-layer {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  pointer-events: none;
}

.particle {
  position: absolute;
  display: block;
  opacity: 0;
}

.is-changing .screen-image {
  animation: newSceneIn 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.fx-angry {
  animation: islandShake 520ms ease both;
}

.fx-happy .particle {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(255, 208, 90, 0.8);
  box-shadow: 0 0 22px rgba(255, 211, 95, 0.9);
  animation: warmFloat 820ms ease-out both;
}

.fx-calm .particle {
  width: 30px;
  height: 30px;
  border: 2px solid rgba(109, 205, 187, 0.5);
  border-radius: 50%;
  animation: calmRipple 900ms ease-out both;
}

.fx-anxious .particle {
  width: 9px;
  height: 18px;
  border-radius: 60% 0 60% 0;
  background: rgba(217, 155, 66, 0.74);
  transform: rotate(35deg);
  animation: leafDrift 900ms ease-out both;
}

.fx-sad .particle {
  width: 2px;
  height: 64px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.58);
  transform: rotate(14deg);
  animation: rainDrop 820ms linear both;
}

.fx-angry .particle {
  width: 7px;
  height: 26px;
  border-radius: 999px;
  background: rgba(255, 105, 71, 0.72);
  box-shadow: 0 0 12px rgba(255, 120, 70, 0.75);
  animation: emberRise 780ms ease-out both;
}

@keyframes newSceneIn {
  0% {
    opacity: 0.18;
    transform: scale(1.035);
    filter: blur(5px) saturate(1.12);
  }
  100% {
    opacity: 1;
    transform: scale(1);
    filter: blur(0) saturate(1);
  }
}

@keyframes islandShake {
  0%, 100% { transform: translate3d(0, 0, 0); }
  16% { transform: translate3d(-2px, 1px, 0); }
  34% { transform: translate3d(2px, -1px, 0); }
  50% { transform: translate3d(-1px, -1px, 0); }
  66% { transform: translate3d(1px, 1px, 0); }
}

@keyframes warmFloat {
  0% { opacity: 0; transform: translate3d(0, 18px, 0) scale(0.45); }
  22% { opacity: 0.95; }
  100% { opacity: 0; transform: translate3d(0, -90px, 0) scale(1.2); }
}

@keyframes calmRipple {
  0% { opacity: 0.72; transform: scale(0.3); }
  100% { opacity: 0; transform: scale(3.4); }
}

@keyframes leafDrift {
  0% { opacity: 0; transform: translate3d(-10px, -20px, 0) rotate(10deg); }
  20% { opacity: 0.88; }
  100% { opacity: 0; transform: translate3d(46px, 150px, 0) rotate(220deg); }
}

@keyframes rainDrop {
  0% { opacity: 0; transform: translate3d(0, -110px, 0) rotate(14deg); }
  15% { opacity: 0.85; }
  100% { opacity: 0; transform: translate3d(-54px, 360px, 0) rotate(14deg); }
}

@keyframes emberRise {
  0% { opacity: 0; transform: translate3d(0, 78px, 0) scale(0.6); }
  20% { opacity: 0.92; }
  100% { opacity: 0; transform: translate3d(0, -140px, 0) scale(1.08); }
}

@keyframes toastIn {
  0% { opacity: 0; transform: translate3d(-50%, 8px, 0); }
  14%, 82% { opacity: 1; transform: translate3d(-50%, 0, 0); }
  100% { opacity: 0; transform: translate3d(-50%, 8px, 0); }
}

.edit-page {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 15;
  width: 100vw;
  height: 100vh;
  overflow-y: auto;
  background: linear-gradient(180deg, #f9fbfa 0%, #ffffff 100%);
  color: #2e3237;
}

.ios-bar {
  height: 5.7vh;
  padding: 4.6vh 7.7vw 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  font-weight: 700;
  font-size: 15px;
  color: #070707;
}

.ios-icons {
  font-size: 12px;
}

.edit-header {
  height: 5.2vh;
  padding: 0 5.5vw;
  display: flex;
  align-items: center;
}

.edit-nav-button {
  width: 48px;
  font-size: 34px;
  line-height: 1;
  color: #23272b;
}

.edit-title {
  flex: 1;
  text-align: center;
  font-size: 24px;
  font-weight: 700;
}

.edit-save {
  width: 56px;
  color: #9aaa46;
  font-size: 18px;
  font-weight: 600;
  text-align: right;
}

.edit-card {
  width: 91.8vw;
  margin: 1.4vh auto 3vh;
  padding: 3.8vh 4.3vw 3.5vh;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10px 28px rgba(68, 84, 88, 0.08);
}

.edit-emotion {
  display: flex;
  gap: 10px;
  align-items: center;
  padding-bottom: 3.2vh;
  border-bottom: 1px solid #edf0ee;
}

.edit-face {
  flex: 0 0 auto;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #93cff5;
  color: #111;
  font-size: 29px;
  line-height: 1;
}

.edit-mood-line {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 20px;
  font-weight: 700;
}

.edit-strength {
  padding: 2px 7px;
  border-radius: 10px;
  background: #eef8ff;
  color: #4b98d4;
  font-size: 12px;
  font-weight: 600;
}

.edit-time {
  margin-top: 6px;
  color: #777;
  font-size: 13px;
}

.edit-section {
  margin-top: 3.4vh;
}

.edit-label {
  display: block;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 1.4vh;
}

.edit-sub {
  margin-top: -1.5vh;
  margin-bottom: 1.5vh;
  color: #9a9a9a;
  font-size: 12px;
}

.edit-field-wrap {
  position: relative;
}

.edit-textarea {
  width: 100%;
  min-height: 62px;
  border: 1.5px solid #afbd78;
  border-radius: 14px;
  padding: 10px 14px 22px;
  color: #555;
  background: #fff;
  line-height: 1.65;
  font-size: 13px;
}

.edit-textarea.small {
  min-height: 50px;
}

.edit-count {
  position: absolute;
  right: 16px;
  bottom: 8px;
  color: #777;
  font-size: 13px;
}

.edit-chip-row {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}

.edit-chip {
  position: relative;
  min-width: 48px;
  min-height: 22px;
  border: 1px solid #ecefee;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.94);
  color: #555;
  text-align: center;
  line-height: 22px;
  padding: 0 6px;
  font-size: 12px;
  box-shadow: 0 8px 18px rgba(80, 90, 94, 0.05);
}

.edit-chip.is-selected {
  border-color: #cdd8a1;
  color: #9aaa46;
  background: #fbfcf5;
}

.edit-chip.is-selected::after {
  content: "✓";
  position: absolute;
  right: 5px;
  top: 4px;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #a9be65;
  color: white;
  font-size: 11px;
  line-height: 16px;
}

.edit-scene-search {
  height: 34px;

}

.edit-scene-grid {
  display: flex;
  gap: 3px;
  margin-top: 5px;
}

.edit-scene {
  width: 10.9%;
  flex: 0 0 10.9%;
  min-height: 38px;
  border: 1px solid #eef0ef;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.94);
  color: #555;

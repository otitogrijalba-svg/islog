page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #eef6f5;
}

.app-shell {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #edf6f4;
}

.screen-image,
.picker-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
}

.screen-image {
  z-index: 1;
}

.hit {
  position: absolute;
  z-index: 5;
  padding: 0;
  margin: 0;
  border: 0;
  line-height: 0;
  font-size: 0;
  background: rgba(255, 255, 255, 0);
  color: transparent;
}

.hit::after {
  border: 0;
}

.share-button::after {
  border: 0;
}

.plus-hit {

  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 11px;
  color: #8c8c8c;
  background: #fff;
}

.scene-grid {
  display: flex;
  gap: 3px;
  margin-top: 5px;
}

.scene-option {
  width: 10.9%;
  flex: 0 0 10.9%;
  min-height: 38px;
  border: 1px solid #eef0ef;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.94);
  color: #555;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4px 1px;
}

.scene-option.selected {
  border-color: #aebc72;
  color: #9aaa46;
  background: #fbfcf5;
}

.scene-option-icon {
  font-size: 13px;
  line-height: 1.1;
}

.scene-option-name {
  font-size: 9px;
  white-space: nowrap;
}
